# Server
PORT=4000
NODE_ENV=development

# Postgres connection string (Render gives you this automatically
# when you attach a managed Postgres instance to this service)
DATABASE_URL=postgresql://user:password@localhost:5432/kidssafecircle

# Auth - generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Only this origin may call the API (your Netlify frontend URL)
CORS_ORIGIN=http://localhost:5173

# Content moderation - see src/services/moderation.js
# "stub" runs a local keyword + heuristic check only, good for local dev.
# Switch to a real provider before letting real children use this.
MODERATION_PROVIDER=stub
# MODERATION_API_KEY=your_vision_or_moderation_api_key

# Used to build the "verify your email" link sent to parents at signup
APP_PUBLIC_URL=http://localhost:5173
